; Engine configuration file.
; Edit with Godot when possible; this prototype keeps the scene intentionally small.

config_version=5

[application]

config/name="Clause 13: Night Notary"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]

focus_input={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":84,"ctrl_pressed":true)]
}
restart_case={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82,"ctrl_pressed":true)]
}

